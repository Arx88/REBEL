#!/bin/bash

# ============================================
# REBEL CLI Helper
# ============================================
# Usage: ./rebel [command]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$SCRIPT_DIR/backend"
FRONTEND_DIR="$SCRIPT_DIR/../app"

# Colores
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
WHITE='\033[1;37m'
NC='\033[0m'

show_banner() {
    echo -e "${CYAN}"
    echo "  ____  _____ ____  _____ _     "
    echo " |  _ \| ____| __ )| ____| |    "
    echo " | |_) |  _| |  _ \|  _| | |    "
    echo " |  _ <| |___| |_) | |___| |___ "
    echo " |_| \_\_____|____/|_____|_____|"
    echo -e "${NC}"
}

show_help() {
    show_banner
    echo -e "${WHITE}Multi-Agent Orchestrator CLI${NC}"
    echo ""
    echo "Usage: ./rebel [command]"
    echo ""
    echo -e "${CYAN}Commands:${NC}"
    echo ""
    echo "  start         Start all services (backend + frontend)"
    echo "  backend       Start backend only"
    echo "  frontend      Start frontend only"
    echo "  stop          Stop all services"
    echo ""
    echo "  status        Check system status"
    echo "  agents        Show agent pool status"
    echo "  health        Run full health check"
    echo ""
    echo "  test          Send a test task"
    echo "  tasks         List recent tasks"
    echo "  logs          Show backend logs"
    echo ""
    echo "  install       Run installation"
    echo "  update        Update dependencies"
    echo "  clean         Clean build artifacts"
    echo ""
    echo "  help          Show this help"
    echo ""
    echo -e "${CYAN}Examples:${NC}"
    echo ""
    echo "  ./rebel start           # Start everything"
    echo "  ./rebel status          # Check if running"
    echo "  ./rebel test            # Test the system"
    echo ""
}

cmd_start() {
    if [ -f "$SCRIPT_DIR/start.sh" ]; then
        "$SCRIPT_DIR/start.sh"
    else
        echo -e "${RED}Error: start.sh not found. Run ./install.sh first${NC}"
        exit 1
    fi
}

cmd_backend() {
    echo -e "${CYAN}Starting Backend...${NC}"
    cd "$BACKEND_DIR"
    npm run dev
}

cmd_frontend() {
    if [ -d "$FRONTEND_DIR" ]; then
        echo -e "${CYAN}Starting Frontend...${NC}"
        cd "$FRONTEND_DIR"
        npm run dev
    else
        echo -e "${YELLOW}Frontend directory not found${NC}"
    fi
}

cmd_stop() {
    echo -e "${YELLOW}Stopping services...${NC}"
    pkill -f "ts-node-dev.*server.ts" 2>/dev/null || true
    pkill -f "vite" 2>/dev/null || true
    sleep 1
    echo -e "${GREEN}Services stopped${NC}"
}

cmd_status() {
    echo ""
    echo -e "${CYAN}REBEL System Status${NC}"
    echo -e "${CYAN}====================${NC}"
    echo ""
    
    # Backend status
    echo -n "Backend API: "
    if curl -s http://localhost:3001/api/status > /dev/null 2>&1; then
        RESPONSE=$(curl -s http://localhost:3001/api/status)
        echo -e "${GREEN}Running${NC}"
        echo "$RESPONSE" | python3 -m json.tool 2>/dev/null || echo "$RESPONSE"
    else
        echo -e "${RED}Not running${NC}"
    fi
    
    echo ""
    
    # Frontend status
    echo -n "Frontend: "
    if curl -s http://localhost:5173 > /dev/null 2>&1; then
        echo -e "${GREEN}Running at http://localhost:5173${NC}"
    else
        echo -e "${YELLOW}Not running${NC}"
    fi
    
    echo ""
}

cmd_agents() {
    echo ""
    echo -e "${CYAN}Agent Pool Status${NC}"
    echo -e "${CYAN}=================${NC}"
    echo ""
    
    RESPONSE=$(curl -s http://localhost:3001/api/agents/status 2>/dev/null)
    if [ ! -z "$RESPONSE" ]; then
        echo "$RESPONSE" | python3 -m json.tool 2>/dev/null || echo "$RESPONSE"
    else
        echo -e "${RED}Cannot connect to backend${NC}"
    fi
    
    echo ""
}

cmd_health() {
    if [ -f "$SCRIPT_DIR/healthcheck.sh" ]; then
        "$SCRIPT_DIR/healthcheck.sh"
    else
        echo -e "${YELLOW}Health check script not found${NC}"
        cmd_status
    fi
}

cmd_test() {
    echo -e "${CYAN}Sending test task...${NC}"
    echo ""
    
    RESPONSE=$(curl -s -X POST http://localhost:3001/api/tasks \
        -H "Content-Type: application/json" \
        -d '{
            "userInput": "Analiza brevemente que puedes hacer y responde en 2-3 oraciones.",
            "context": "Esta es una tarea de prueba para verificar el sistema."
        }' 2>/dev/null)
    
    if [ ! -z "$RESPONSE" ]; then
        echo "$RESPONSE" | python3 -m json.tool 2>/dev/null || echo "$RESPONSE"
        echo ""
        echo -e "${GREEN}Task created! Check the dashboard or use './rebel tasks'${NC}"
    else
        echo -e "${RED}Cannot connect to backend. Is it running?${NC}"
        echo -e "Try: ${CYAN}./rebel start${NC}"
    fi
}

cmd_tasks() {
    echo ""
    echo -e "${CYAN}Recent Tasks${NC}"
    echo -e "${CYAN}============${NC}"
    echo ""
    
    RESPONSE=$(curl -s "http://localhost:3001/api/tasks?limit=10" 2>/dev/null)
    if [ ! -z "$RESPONSE" ]; then
        echo "$RESPONSE" | python3 -m json.tool 2>/dev/null || echo "$RESPONSE"
    else
        echo -e "${RED}Cannot connect to backend${NC}"
    fi
}

cmd_logs() {
    LOG_FILE="$BACKEND_DIR/logs/app.log"
    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        echo -e "${YELLOW}No log file found. Showing npm output instead...${NC}"
        cd "$BACKEND_DIR"
        npm run dev
    fi
}

cmd_install() {
    if [ -f "$SCRIPT_DIR/install.sh" ]; then
        "$SCRIPT_DIR/install.sh"
    else
        echo -e "${YELLOW}Running Node.js setup...${NC}"
        node "$SCRIPT_DIR/setup.js"
    fi
}

cmd_update() {
    echo -e "${CYAN}Updating dependencies...${NC}"
    
    echo ""
    echo "Backend:"
    cd "$BACKEND_DIR"
    npm update
    
    if [ -d "$FRONTEND_DIR" ]; then
        echo ""
        echo "Frontend:"
        cd "$FRONTEND_DIR"
        npm update
    fi
    
    echo ""
    echo -e "${GREEN}Update complete!${NC}"
}

cmd_clean() {
    echo -e "${YELLOW}Cleaning build artifacts...${NC}"
    
    rm -rf "$BACKEND_DIR/dist" 2>/dev/null
    rm -rf "$BACKEND_DIR/node_modules/.cache" 2>/dev/null
    rm -rf "$FRONTEND_DIR/node_modules/.vite" 2>/dev/null
    
    echo -e "${GREEN}Clean complete!${NC}"
}

# Main
case "$1" in
    start)
        cmd_start
        ;;
    backend)
        cmd_backend
        ;;
    frontend)
        cmd_frontend
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    agents)
        cmd_agents
        ;;
    health|healthcheck)
        cmd_health
        ;;
    test)
        cmd_test
        ;;
    tasks)
        cmd_tasks
        ;;
    logs)
        cmd_logs
        ;;
    install)
        cmd_install
        ;;
    update)
        cmd_update
        ;;
    clean)
        cmd_clean
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
